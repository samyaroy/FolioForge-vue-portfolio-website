# Response headers for the static-asset host (Cloudflare Workers assets and
# Pages both read this file from the output directory; Vite copies it there).

# Everything under /assets/ is emitted by Vite with a content hash in its name
# (index-DG4kiD7N.css, inter-latin-opsz-normal-BwkfbSeq.woff2, ...). A changed
# file always gets a new name, so a given URL's bytes never change and browsers
# can keep it for a year without re-checking. Without this, Cloudflare's
# default makes every repeat visit revalidate each script, stylesheet and font.
#
# Do not extend this to HTML or to unhashed files in public/: those keep their
# names across deploys and must stay revalidated, or visitors would be stuck on
# an old page that points at assets the next deploy removed.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
